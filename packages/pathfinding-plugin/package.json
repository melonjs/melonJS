{
	"name": "@melonjs/pathfinding-plugin",
	"version": "1.0.0",
	"description": "melonJS A* pathfinding plugin",
	"homepage": "https://www.npmjs.com/package/@melonjs/pathfinding-plugin",
	"type": "module",
	"keywords": [
		"2D",
		"HTML5",
		"javascript",
		"TypeScript",
		"ES6",
		"melonjs",
		"plugin",
		"pathfinding",
		"astar",
		"a-star",
		"grid",
		"tiled",
		"ai"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melonjs/melonJS.git",
		"directory": "packages/pathfinding-plugin"
	},
	"bugs": {
		"url": "https://github.com/melonjs/melonJS/issues"
	},
	"license": "MIT",
	"author": "AltByte Pte Ltd",
	"funding": "https://github.com/sponsors/melonjs",
	"exports": {
		".": "./build/index.js"
	},
	"types": "./build/index.d.ts",
	"sideEffects": false,
	"files": [
		"build/",
		"package.json",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"peerDependencies": {
		"melonjs": ">=20.12.0"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"concurrently": "^9.2.1",
		"esbuild": "^0.28.0",
		"melonjs": "workspace:*",
		"tsconfig": "workspace:*",
		"tsx": "^4.23.1",
		"typescript": "^6.0.2",
		"vite": "8.1.5",
		"vitest": "^4.1.11"
	},
	"scripts": {
		"dev": "concurrently --raw \"pnpm build:watch\" \"pnpm tsc:watch\"",
		"build": "tsx scripts/build.ts && pnpm types",
		"build:watch": "tsx scripts/build.ts watch",
		"prepublishOnly": "pnpm clean && pnpm build",
		"clean": "tsx scripts/clean.ts",
		"types": "tsc --project tsconfig.build.json",
		"tsc:watch": "tsc --project tsconfig.build.json --watch --noUnusedParameters false --noUnusedLocals false --preserveWatchOutput",
		"test": "vitest run",
		"test:types": "tsc",
		"lint": "eslint src tests",
		"visual": "vite --config visual/vite.config.ts"
	}
}
