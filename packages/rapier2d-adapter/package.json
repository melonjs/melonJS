{
	"name": "@melonjs/rapier2d-adapter",
	"version": "1.1.0",
	"description": "melonJS physics adapter for Rapier 2D (WebAssembly)",
	"homepage": "https://www.npmjs.com/package/@melonjs/rapier2d-adapter",
	"type": "module",
	"keywords": [
		"2D",
		"HTML5",
		"javascript",
		"TypeScript",
		"es6",
		"Canvas",
		"WebGL",
		"game",
		"engine",
		"physics",
		"rapier",
		"rapier2d",
		"wasm",
		"webassembly",
		"browser"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melonjs/melonJS.git",
		"directory": "packages/rapier2d-adapter"
	},
	"bugs": {
		"url": "https://github.com/melonjs/melonJS/issues"
	},
	"license": "MIT",
	"author": "Olivier Biot (AltByte Pte Ltd)",
	"funding": "https://github.com/sponsors/melonjs",
	"types": "./build/index.d.ts",
	"exports": {
		".": "./build/index.js"
	},
	"files": [
		"build/",
		"package.json",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"peerDependencies": {
		"melonjs": ">=20.0.0"
	},
	"dependencies": {
		"@dimforge/rapier2d-compat": "^0.21.0"
	},
	"devDependencies": {
		"concurrently": "^9.2.1",
		"esbuild": "^0.28.0",
		"melonjs": "workspace:*",
		"tsconfig": "workspace:*",
		"tsx": "^4.23.1",
		"typescript": "^6.0.2",
		"vitest": "^4.1.10"
	},
	"scripts": {
		"dev": "concurrently --raw \"pnpm build:watch\" \"pnpm tsc:watch\"",
		"build": "tsx scripts/build.ts && pnpm types",
		"build:watch": "tsx scripts/build.ts watch",
		"lint": "eslint src/**.ts",
		"prepublishOnly": "pnpm clean && pnpm build",
		"clean": "tsx scripts/clean.ts",
		"types": "tsc --project tsconfig.build.json",
		"tsc:watch": "tsc --project tsconfig.build.json --watch --noUnusedParameters false --noUnusedLocals false --preserveWatchOutput",
		"test": "vitest run"
	}
}
