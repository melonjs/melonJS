{
	"extends": "tsconfig/base.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx"
	},
	"include": ["./src"],
	// Tiled writes its tilesets as `.tsx` — XML, not React. Left in, TS parses
	// them as JSX and the type gate drowns in syntax errors on data files.
	"exclude": ["src/**/assets/**/*.tsx"]
}
