# melonJS example asset — a supply crate with three textured materials.
#
# Authored for the per-material texture example (#1573): the four sides are
# wooden boards, the lid and floor are steel plate, and a shipping label sits
# just proud of the front face. Three `usemtl` groups, three different
# `map_Kd` maps — which is exactly what a single shared texture binding
# cannot render.
mtllib crate.mtl

v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -0.62 -0.62 1.02
v  0.62 -0.62 1.02
v  0.62  0.62 1.02
v -0.62  0.62 1.02

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn  0  0  1
vn  0  0 -1
vn -1  0  0
vn  1  0  0
vn  0  1  0
vn  0 -1  0

usemtl wood
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 2/1/4 6/2/4 7/3/4
f 2/1/4 7/3/4 3/4/4
f 6/1/2 5/2/2 8/3/2
f 6/1/2 8/3/2 7/4/2
f 5/1/3 1/2/3 4/3/3
f 5/1/3 4/3/3 8/4/3

usemtl metal
f 4/1/5 3/2/5 7/3/5
f 4/1/5 7/3/5 8/4/5
f 5/1/6 6/2/6 2/3/6
f 5/1/6 2/3/6 1/4/6

usemtl label
f 9/1/1 10/2/1 11/3/1
f 9/1/1 11/3/1 12/4/1
