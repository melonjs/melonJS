{
	"$schema": "https://v2-9-5.turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/", "dist/"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/eslint.config.mjs",
				"$TURBO_ROOT$/packages/tsconfig/**",
				"$TURBO_ROOT$/packages/*/build/**/*.d.ts"
			],
			"outputs": []
		},
		"test:types": {}
	}
}
